<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:ems="10"
        android:hint="Id"
        android:inputType="text" />

    <EditText
        android:id="@+id/editProductName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Nome do Produto" />

    <EditText
        android:id="@+id/editProductPrice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Preço"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/editProductDescription"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Descrição" />

    <EditText
        android:id="@+id/edtQuantidade"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:ems="10"
        android:hint="Quantidade"
        android:inputType="number" />

    <Button
        android:id="@+id/btnInserirProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inserir Produto" />
    <Button
        android:id="@+id/btnListarProdutos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listar Produtos" />

    <Button
        android:id="@+id/btnBuscar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscar Produto" />

    <Button
        android:id="@+id/btnExcluirTodos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excluir Todos" />

    <Button
        android:id="@+id/btnAtualizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atualizar Produto" />

    <TextView
        android:id="@+id/tv_produtos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>